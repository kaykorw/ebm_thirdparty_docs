{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kayko EBM API",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/introduction"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#DE37A3",
    "light": "#5FB4E4",
    "dark": "#DE37A3"
  },
  "navbar": {
    "links": []
  },
  "styling": {
    "css": ["/style.css"]
  },
  "api": {
    "openapi": "openapi.json",
    "url": "full",
    "mdx": {
      "server": [
        "http://localhost:3000/ebm"
      ]
    },
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "php",
        "json"
      ],
      "prefill": true,
      "autogenerate": false
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "introduction",
              "concepts/api-keys",
              "workflows/getting-started",
              "concepts/data-sync"
            ]
          },
          {
            "group": "API",
            "icon": "code",
            "pages": [
              "api/initialization",
              "api/reference-data",
              "api/branches-customers",
              "api/items",
              "api/imports",
              "api/sales",
              "api/purchases",
              "api/stock"
            ]
          },
          {
            "group": "Calculations",
            "icon": "calculator",
            "pages": [
              "calculations/overview",
              "calculations/vat-formulas",
              "calculations/line-items",
              "calculations/discounts",
              "calculations/invoice-totals",
              "calculations/stock-and-purchases"
            ]
          },
          {
            "group": "Lookup",
            "icon": "table",
            "pages": [
              "reference/response-codes",
              "reference/enumerations",
              "reference/field-reference",
              "reference/country-codes",
              "reference/currency-codes",
              "reference/changelog"
            ]
          },
          {
            "group": "About",
            "icon": "circle-info",
            "pages": [
              "concepts/onboarding",
              "contributions/overview"
            ]
          }
        ]
      },
      {
        "tab": "API Playground",
        "icon": "play",
        "groups": [
          {
            "group": "API Playground",
            "icon": "play",
            "openapi": "openapi.json",
            "pages": [
              "playground/overview",
              {
                "group": "Initialization",
                "icon": "key",
                "pages": [
                  "POST /initialize/enable",
                  "GET /initialize/status/{deploymentId}",
                  "POST /initialize/init"
                ]
              },
              {
                "group": "Reference Data",
                "icon": "database",
                "pages": [
                  "GET /constants/countries",
                  "GET /constants/currencies",
                  "GET /constants/packaging",
                  "GET /constants/quantity",
                  "GET /constants/taxes",
                  "GET /constants/products",
                  "GET /constants/transactions",
                  "GET /constants/sales-receipt-types",
                  "GET /constants/purchase-receipt-types",
                  "GET /constants/payment-modes",
                  "GET /constants/transaction-progress",
                  "GET /constants/registrations",
                  "GET /constants/stock-types",
                  "GET /constants/refund-reasons",
                  "GET /constants/import-item-statuses",
                  "GET /constants/taxpayer-statuses"
                ]
              },
              {
                "group": "Branches & Customers",
                "icon": "building",
                "pages": [
                  "POST /customers/select",
                  "POST /customers/create",
                  "POST /branches/saveBrancheUsers",
                  "POST /branches/saveBrancheInsurances",
                  "POST /branches/saveBrancheCustomers"
                ]
              },
              {
                "group": "Items",
                "icon": "box",
                "pages": [
                  "POST /items/saveItems",
                  "POST /items/selectItems",
                  "POST /items/saveItemComposition"
                ]
              },
              {
                "group": "Imports",
                "icon": "ship",
                "pages": [
                  "POST /imports/selectImportItems",
                  "POST /imports/updateImportItems"
                ]
              },
              {
                "group": "Sales",
                "icon": "receipt",
                "pages": [
                  "POST /trnsSales/saveSales",
                  "POST /trnsSales/resendSales"
                ]
              },
              {
                "group": "Purchases",
                "icon": "cart-shopping",
                "pages": [
                  "POST /trnsPurchase/selectTrnsPurchaseSales",
                  "POST /trnsPurchase/savePurchases"
                ]
              },
              {
                "group": "Stock",
                "icon": "boxes-stacked",
                "pages": [
                  "POST /stock/saveStockItems",
                  "POST /stock/selectStockItems",
                  "POST /stockMaster/saveStockMaster"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
